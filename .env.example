# Quick Resume Maker - Environment Configuration

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# LLM Configuration
LLM_PROVIDER=anthropic  # anthropic | gemini | ollama (ollama = free, local, no key)
# Use a model ID your key has access to. Known-good values:
#   anthropic: claude-sonnet-4-5 | claude-haiku-4-5 (cheap, good for testing)
#   gemini:    gemini-3.8-flash (current; older flash models are retired)
#   ollama:    llama3.1:8b | qwen2.5:7b (must be pulled: `ollama pull <model>`)
LLM_MODEL=claude-sonnet-4-5
# Ollama (only used when LLM_PROVIDER=ollama)
# Local dev default: http://localhost:11434
# Docker default (set in docker-compose.yml): http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Anthropic / Gemini API keys (set these in production)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding Configuration
EMBEDDING_PROVIDER=local  # local | anthropic | gemini
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers default
BGE_SMALL_MODEL=bge-small-en-v1.5  # optional upgrade

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_PREFIX=profile_

# Server Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173